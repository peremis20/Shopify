# Firebase Web App configuration.
# Copy this file to `.env.local` and fill in the values from your Firebase
# project settings (Project settings > General > Your apps > Web app > SDK setup).
# All NEXT_PUBLIC_* variables are exposed to the browser (this is expected for
# the Firebase web SDK — security is enforced by Firestore/Storage rules).

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------------------
# Insights dashboard (/analytics): Google Analytics 4 + Search Console
# Without these the dashboard shows sample data. Never commit real values.
# ---------------------------------------------------------------------------

# Option A (recommended): "Connect with Google" button.
# OAuth client from Google Cloud > Credentials > OAuth client ID (Web application),
# redirect URI: https://YOUR-SITE/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Neon Postgres connection string (Neon console > your project > Connect).
# Stores the connected Google account and recent reports.
DATABASE_URL=
# Optional: secret used to encrypt the stored Google token (defaults to the client secret).
SESSION_SECRET=
# Optional: your public address, if the app runs behind a proxy, e.g. https://insights.example.com
APP_URL=

# Option B: a service account, with the properties fixed here.
# The service account key file, pasted as one line of JSON (or base64 of it).
GOOGLE_SERVICE_ACCOUNT_JSON=
# GA4 property ID (numbers only), found in GA Admin > Property details.
GA4_PROPERTY_ID=
# Search Console property exactly as it appears in GSC:
# "sc-domain:example.com" for a domain property, or "https://www.example.com/".
GSC_SITE_URL=

# Optional: require this password to open /analytics (any username works).
DASHBOARD_PASSWORD=
