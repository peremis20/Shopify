{%- liquid
  assign s = section.settings
  assign heroimg = s.image
  if heroimg == blank
    assign heroimg = settings.hero_image
  endif
  assign show_rating = false
  if s.rating_text != blank and s.stars != blank and s.stars > 0
    assign show_rating = true
  endif
-%}
<section class="pm-hero" style="position:relative;overflow:hidden;background:{{ s.overlay_color | default: '#2a1b4a' }};">
  {% if heroimg != blank %}<img class="pm-hero-img" src="{{ heroimg | image_url: width: 1500 }}" srcset="{{ heroimg | image_url: width: 640 }} 640w, {{ heroimg | image_url: width: 900 }} 900w, {{ heroimg | image_url: width: 1200 }} 1200w, {{ heroimg | image_url: width: 1600 }} 1600w, {{ heroimg | image_url: width: 2000 }} 2000w" sizes="100vw" width="{{ heroimg.width }}" height="{{ heroimg.height }}" fetchpriority="high" loading="eager" decoding="async" alt="{{ s.image_alt | default: 'Premium Peremis supplements' | escape }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;">{% endif %}
  <div style="position:absolute;inset:0;background:{{ s.overlay_color | default: '#2a1b4a' }};opacity:{{ s.overlay_opacity | default: 55 | divided_by: 100.0 }};"></div>
  <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.32),rgba(0,0,0,0) 62%);"></div>
  <div class="pm-hero-inner" style="position:relative;max-width:1240px;margin:0 auto;padding:{{ s.pad_top | default: 96 }}px 28px {{ s.pad_bottom | default: 96 }}px;min-height:{{ s.min_height | default: 620 }}px;display:flex;flex-direction:column;justify-content:center;color:{{ s.text_color | default: '#ffffff' }};">
    <div class="pm-hero-copy" style="max-width:620px;">
      {%- if show_rating -%}
      <div class="pm-hero-row pm-hero-rating" style="display:flex;align-items:center;gap:10px;margin-bottom:18px;">
        <span style="color:#ecb52b;font-size:19px;letter-spacing:2px;">{% for i in (1..5) %}{% if forloop.index <= s.stars %}★{% else %}☆{% endif %}{% endfor %}</span>
        <span style="font-size:14px;font-weight:600;opacity:.9;">{{ s.rating_text }}</span>
      </div>
      {%- endif -%}
      <h1 style="font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:64px;line-height:1.02;letter-spacing:-.02em;margin:0 0 18px;color:inherit;">{{ s.heading }}{% if s.heading_accent != blank %}<br><span style="color:{{ s.heading_accent_color | default: '#ecb52b' }};">{{ s.heading_accent }}</span>{% endif %}</h1>
      {% if s.body != blank %}<p class="pm-hero-body" style="font-size:19px;line-height:1.5;max-width:470px;margin:0 0 30px;opacity:.92;">{{ s.body }}</p>{% endif %}
      <div class="pm-hero-row" style="display:flex;gap:14px;flex-wrap:wrap;margin-bottom:26px;">
        <a href="{{ s.primary_link | default: '/collections/all-products' }}" style="display:inline-flex;align-items:center;gap:10px;background:#ecb52b;color:#2a1b4a;font-weight:700;font-size:16px;padding:16px 30px;border-radius:999px;box-shadow:0 8px 22px rgba(236,181,43,.4);text-decoration:none;">{{ s.primary_label }} <span style="font-size:18px;">&rarr;</span></a>
        {% if s.secondary_label != blank %}<a href="{{ s.secondary_link | default: '#pm-learn' }}" class="pm-hero-secondary" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.35);color:#fff;font-weight:600;font-size:16px;padding:16px 30px;border-radius:999px;text-decoration:none;backdrop-filter:blur(4px);">{{ s.secondary_label }}</a>{% endif %}
      </div>
      <div class="pm-hero-row" style="display:flex;gap:22px;flex-wrap:wrap;font-size:14px;font-weight:600;opacity:.92;">
        {% if s.tick1 != blank %}<span style="display:flex;align-items:center;gap:7px;"><span style="color:#5cd6a0;">✓</span> {{ s.tick1 }}</span>{% endif %}
        {% if s.tick2 != blank %}<span style="display:flex;align-items:center;gap:7px;"><span style="color:#5cd6a0;">✓</span> {{ s.tick2 }}</span>{% endif %}
        {% if s.tick3 != blank %}<span style="display:flex;align-items:center;gap:7px;"><span style="color:#5cd6a0;">✓</span> {{ s.tick3 }}</span>{% endif %}
      </div>
    </div>
    {% if s.show_badge %}<div class="pm-hero-badge" style="position:absolute;right:28px;bottom:40px;background:rgba(255,255,255,.95);backdrop-filter:blur(6px);border-radius:16px;padding:14px 18px;display:flex;align-items:center;gap:12px;box-shadow:0 12px 30px rgba(42,27,74,.28);">
      <div style="width:42px;height:42px;border-radius:50%;background:#3d2a6b;color:#ecb52b;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;flex-shrink:0;">{{ s.badge_pill }}</div>
      <div><div style="font-weight:700;font-size:14px;color:#211a33;">{{ s.badge_title }}</div><div style="font-size:12.5px;color:#6f6880;">{{ s.badge_sub }}</div></div>
    </div>{% endif %}
  </div>
</section>
<style>#shopify-section-{{ section.id }} .pm-hero-copy{transform:translateY({{ section.settings.vpos | default: 0 }}px);}@media(max-width:760px){
#shopify-section-{{ section.id }} .pm-hero-inner{padding:56px 22px!important;min-height:540px!important;text-align:center!important;}
#shopify-section-{{ section.id }} .pm-hero-copy{max-width:100%!important;margin:0 auto!important;}
#shopify-section-{{ section.id }} .pm-hero-inner h1{font-size:34px!important;}
#shopify-section-{{ section.id }} .pm-hero-body{display:none!important;}
#shopify-section-{{ section.id }} .pm-hero-secondary{display:none!important;}
#shopify-section-{{ section.id }} .pm-hero-img{object-position:78% 20%!important;}
#shopify-section-{{ section.id }} .pm-hero-row{justify-content:center!important;}
#shopify-section-{{ section.id }} .pm-hero-rating{flex-direction:column!important;gap:6px!important;}
#shopify-section-{{ section.id }} .pm-hero-badge{display:none!important;}
}</style>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "range", "id": "vpos", "label": "Text vertical position", "min": -150, "max": 150, "step": 5, "unit": "px", "default": 0, "info": "Negative moves text up, positive moves it down." },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "header", "content": "Background" },
    { "type": "paragraph", "content": "Set the hero image in Theme settings > Homepage hero (it stays stable there). Only use the field below if you want to override it just for this section." },
    { "type": "image_picker", "id": "image", "label": "Background image (optional override)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text (SEO/accessibility)", "default": "Premium Peremis supplements" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#2a1b4a" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55 },
    { "type": "range", "id": "min_height", "label": "Height", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 620 },
    { "type": "header", "content": "Text" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "range", "id": "stars", "label": "Filled stars", "min": 0, "max": 5, "step": 1, "default": 5, "info": "Set to 0, or clear the rating text, to hide the star row completely." },
    { "type": "text", "id": "rating_text", "label": "Rating text", "info": "Leave empty to hide the star row and rating line. Only enter a figure backed by real reviews." },
    { "type": "text", "id": "heading", "label": "Heading line 1", "default": "Tired of feeling" },
    { "type": "text", "id": "heading_accent", "label": "Heading line 2 (accent)", "default": "tired?" },
    { "type": "color", "id": "heading_accent_color", "label": "Accent line color", "default": "#ecb52b" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "The foggy mornings. The afternoon crash. The stress that never quite switches off. Peremis helps you feel calm, clear and genuinely energized again, starting with your very first bottle." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Find my formula" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Learn the basics" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "header", "content": "Trust ticks" },
    { "type": "text", "id": "tick1", "label": "Tick 1", "default": "Non-GMO" },
    { "type": "text", "id": "tick2", "label": "Tick 2", "default": "Manufactured in the USA from the finest of foreign and domestic ingredients" },
    { "type": "text", "id": "tick3", "label": "Tick 3", "default": "Free shipping from $24.99" },
    { "type": "header", "content": "Guarantee badge" },
    { "type": "checkbox", "id": "show_badge", "label": "Show guarantee badge", "default": true },
    { "type": "text", "id": "badge_pill", "label": "Badge pill", "default": "90d" },
    { "type": "text", "id": "badge_title", "label": "Badge title", "default": "Money-back guarantee" },
    { "type": "text", "id": "badge_sub", "label": "Badge subtitle", "default": "Love it or your money back" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
