<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
 {%- capture ecom_header_content -%}{%- render 'ecom_header' -%}{%- endcapture -%}{%- unless ecom_header_content contains 'Liquid error' -%}{{ ecom_header_content }}{%- endunless -%}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_plum }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- if template.name == 'index' -%}
    <title>Science-Backed Supplements for Energy, Focus &amp; Sleep | Peremis</title>
    <meta name="description" content="Supplements built on science, not hype. Support your energy, focus, sleep, and overall wellness with clean, third-party tested formulas manufactured in the USA from the finest of foreign and domestic ingredients.">
  {%- else -%}
    <title>{{ page_title }}{% unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless %}</title>
{% liquid
  assign custom_meta_description = page_description

  case request.path
    when '/policies/refund-policy'
      assign custom_meta_description = 'Read the Peremis Return & Refund Policy, including the 90-day return window, eligibility, refunds, exchanges and damaged or incorrect orders.'

    when '/policies/terms-of-service'
      assign custom_meta_description = 'Review the Peremis Terms of Service covering orders, payments, website use, returns, shipping, intellectual property and other applicable terms.'

    when '/policies/privacy-policy'
      assign custom_meta_description = 'Learn how Peremis collects, uses, shares and protects personal information, including cookies, marketing data and your privacy rights.'

    when '/policies/shipping-policy'
      assign custom_meta_description = 'Review Peremis shipping information, including 1–3 business day processing, delivery options, tracking, shipping to the U.S. and Canada, and order issues.'
  endcase
%}

{% if custom_meta_description != blank %}
  <meta name="description" content="{{ custom_meta_description | escape }}">
{% endif %}
  {%- endif -%}
  {%- if collection.handle == 'all' -%}<meta name="robots" content="noindex,follow">{%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"></noscript>
  {%- if template.name == 'index' and settings.hero_image != blank -%}
    <link rel="preload" as="image" href="{{ settings.hero_image | image_url: width: 1500 }}" imagesrcset="{{ settings.hero_image | image_url: width: 640 }} 640w, {{ settings.hero_image | image_url: width: 900 }} 900w, {{ settings.hero_image | image_url: width: 1200 }} 1200w, {{ settings.hero_image | image_url: width: 1600 }} 1600w, {{ settings.hero_image | image_url: width: 2000 }} 2000w" imagesizes="100vw" fetchpriority="high">
  {%- endif -%}

  {{ content_for_header }}
  {%- render 'structured-data' -%}

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root{
      --pm-purple:{{ settings.color_purple }};
      --pm-plum:{{ settings.color_plum }};
      --pm-gold:{{ settings.color_gold }};
      --pm-cream:{{ settings.color_cream }};
      --pm-green:{{ settings.color_green }};
    }
  </style>
  <script>
    window.PEREMIS_FREE_SHIP = {{ settings.free_shipping_threshold | default: 50 | times: 100 | round }};
    window.PEREMIS_MONEY_FORMAT = {{ shop.money_format | json }};
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>

{%- if canonical_url == 'https://peremis.com/search' -%}<meta name="robots" content="noindex">{%- endif -%}

<style>.SureCust-App .onst-registration-form-container{max-width:820px;margin:0 auto;padding:8px 4px 48px}.SureCust-App h2.title{font-size:2.1rem;font-weight:800;color:var(--pm-plum,#2B1B45);text-align:center;margin:0 0 8px}.SureCust-App p.subtitle{color:#6B6482;text-align:center;margin:0 0 32px;font-size:1.05rem}.SureCust-App .onst-field{margin-bottom:22px}.SureCust-App .onst-field>label{display:block;font-weight:700;color:#4A4360;font-size:.95rem;margin-bottom:10px}.SureCust-App .onst-field input[type=text],.SureCust-App .onst-field input[type=email],.SureCust-App .onst-field input[type=number],.SureCust-App .onst-field input[type=tel],.SureCust-App .onst-field input[type=password],.SureCust-App .onst-field select,.SureCust-App .onst-field textarea{width:100%;border:1.5px solid #DFD7F0;border-radius:16px;padding:16px 18px;font-size:1rem;line-height:1.3;background:#fff;color:#2B1B45;box-shadow:none}.SureCust-App .onst-field input:focus,.SureCust-App .onst-field select:focus{outline:none;border-color:#7B5EC7;box-shadow:0 0 0 3px rgba(123,94,199,.18)}.SureCust-App .onst-field-roptions,.SureCust-App .onst-field-coptions{display:flex;flex-wrap:wrap;gap:14px}.SureCust-App .onst-field-roptions-item,.SureCust-App .onst-field-coptions-item{flex:1 1 170px}.SureCust-App .onst-field-roptions-item>label,.SureCust-App .onst-field-coptions-item>label{display:flex;align-items:center;justify-content:center;text-align:center;min-height:64px;padding:14px 18px;background:#FAF7FC;border:1.5px solid #E6DFCC;border-radius:16px;font-weight:700;color:#2B1B45;cursor:pointer;transition:all .15s ease;margin:0}.SureCust-App .onst-field-roptions-item>label:hover{border-color:#BCA9EA}.SureCust-App .onst-field-roptions-item>label:has(input:checked){border-color:#A98FE0;background:#F4EDFD;box-shadow:0 0 0 1px #A98FE0 inset}.SureCust-App .onst-field-roptions-item input[type=radio],.SureCust-App .onst-field-coptions-item input[type=checkbox]{position:absolute;opacity:0;width:0;height:0;margin:0}.SureCust-App button.onst-custom-form-step,.SureCust-App .onst-custom-form button[type=submit],.SureCust-App .onst-custom-form .btn{background:#3B2560;color:#fff;border:none;border-radius:999px;padding:18px 48px;font-size:1.05rem;font-weight:700;width:100%;cursor:pointer;transition:filter .15s ease}.SureCust-App button.onst-custom-form-step:hover{filter:brightness(1.2)}.SureCust-App a.onst-custom-form-prev-step{display:inline-block;background:#F0EBE0;color:#3B2560;border-radius:999px;padding:15px 34px;font-weight:700;text-decoration:none;cursor:pointer}.SureCust-App .onst-warning{color:#B23A48;font-size:.85rem;display:block;margin-top:6px}.SureCust-App button.onst-custom-form-step,.SureCust-App .onst-custom-form .btn,.SureCust-App .onst-custom-form button[type=submit]{background:#3B2560 !important;border:none !important;border-radius:999px !important;color:#fff !important;padding:18px 48px !important;font-weight:700 !important;font-size:1.05rem !important}.SureCust-App .onst-field input[type=text],.SureCust-App .onst-field input[type=email],.SureCust-App .onst-field input[type=number],.SureCust-App .onst-field input[type=tel],.SureCust-App .onst-field select{border:1.5px solid #DFD7F0 !important;border-radius:16px !important;padding:16px 18px !important;background:#fff !important}.SureCust-App .onst-field-roptions-item>label{border-radius:16px !important;background:#FAF7FC !important;border:1.5px solid #E6DFCC !important}.SureCust-App .onst-field-roptions-item>label:has(input:checked){border-color:#A98FE0 !important;background:#F4EDFD !important}.SureCust-App a.onst-custom-form-prev-step{background:#F0EBE0 !important;color:#3B2560 !important;border-radius:999px !important}.SureCust-App .onst-field-roptions-item>label,.SureCust-App .onst-field-coptions-item>label{display:flex !important;align-items:center !important;justify-content:center !important;text-align:center !important;min-height:64px !important;padding:14px 18px !important;font-weight:700 !important;color:#2B1B45 !important;cursor:pointer !important}.SureCust-App .onst-field:has(a.onst-custom-form-prev-step){order:98;width:auto !important;flex:0 0 auto !important;margin:6px 12px 0 0 !important}.SureCust-App .onst-field:has(button.onst-custom-form-step){order:99;flex:1 1 240px !important;width:auto !important;margin:6px 0 0 !important}</style></head>

<body class="template-{{ template.name }}">

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {%- render 'cart-drawer' -%}
<style>.pm-prod-card > a{background:#fff !important;}</style>

  <script>
    /* Sync the Add-to-cart button price to the selected Subscribe/One-time plan */
    (function () {
      function syncPlanPrice(radio) {
        if (!radio) return;
        var label = radio.closest('[data-plan-opt]');
        if (!label) return;
        var col = label.querySelector('[style*="text-align:right"]');
        var priceDiv = col && col.querySelector('div');
        var form = label.closest('[data-product-form]');
        var btn = form && form.querySelector('button[type="submit"]');
        if (btn && priceDiv && !btn.disabled) {
          btn.textContent = 'Add to cart — ' + priceDiv.textContent.trim();
        }
      }
      document.addEventListener('change', function (e) {
        var r = e.target.closest('[data-plan-radio]');
        if (r) syncPlanPrice(r);
      });
      document.addEventListener('DOMContentLoaded', function () {
        var c = document.querySelector('[data-plan-radio]:checked');
        if (c) syncPlanPrice(c);
      });
    })();
  </script>

{%- capture ecom_footer_content -%}{%- render 'ecom_footer' -%}{%- endcapture -%}{%- unless ecom_footer_content contains 'Liquid error' -%}{{ ecom_footer_content }}{%- endunless -%}
{% render 'peremis-ref-capture' %}
</body>
</html>
